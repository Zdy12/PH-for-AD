heat1 = HeatKernel(n_bins=10, sigma=1.4, n_jobs=1)
heat2 = HeatKernel(n_bins=10, sigma=2.8, n_jobs=1)
persistence_entropy = PersistenceEntropy(nan_fill_value=4)



