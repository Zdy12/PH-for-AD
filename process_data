import numpy as np
import os

data1_X=[]
folder_path1="./AD118/"
files1=os.listdir(folder_path1)
files1.sort()
for filename in files1:
    file_path = os.path.join(folder_path1, filename)
    data_x = np.loadtxt(file_path)
    data_x = 1-data_x
    data1_X.append(data_x)
    # break
print(type(data_x),data_x.shape)
print(type(data1_X),len(data1_X))

data2_X=[]
folder_path2="./CN118/"
files2=os.listdir(folder_path2)
files2.sort()
for filename in files2:
    file_path = os.path.join(folder_path2, filename)
    data_x = np.loadtxt(file_path)
    data_x = 1-data_x
    data2_X.append(data_x)
    # break
print(type(data_x),data_x.shape)
print(type(data2_X),len(data2_X))



from gtda.diagrams import PersistenceLandscape,BettiCurve,HeatKernel,PersistenceEntropy
from gtda.homology import VietorisRipsPersistence
# from gtda.pipeline import Pipeline

VR = VietorisRipsPersistence(homology_dimensions=[0,1,2],metric="precomputed")
#diagrams1 = VR.fit_transform(data1_X)
#diagrams2 = VR.fit_transform(data2_X)
data_X = np.concatenate((data1_X,data2_X),axis=0)
diagrams1 = VR.fit_transform(data_X)
